{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:localmind:context-packet:0.2",
  "title": "LocalMind internal context packet draft 0.2",
  "description": "Internal compiler contract; adapters map it to provider requests. Semantic provenance, scope and revision checks are mandatory in application code.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "context_id",
    "turn_id",
    "project_id",
    "task_id",
    "state_revision",
    "original_request",
    "current_goal",
    "active_constraints",
    "recent_key_messages",
    "relevant_memories",
    "evidence_excerpts",
    "uncertainties",
    "budget",
    "degraded_reason",
    "capture_epoch",
    "pending_conflicts",
    "information_needs"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "context_id": {
      "type": "string",
      "minLength": 1
    },
    "turn_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "state_revision": {
      "type": "integer",
      "minimum": 0
    },
    "original_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "text"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "current_goal": {
      "type": "string"
    },
    "active_constraints": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/excerpt"
          },
          {
            "required": [
              "subject_key",
              "effective_revision",
              "source_event_ids"
            ]
          }
        ]
      }
    },
    "recent_key_messages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/excerpt"
      }
    },
    "relevant_memories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/excerpt"
      }
    },
    "evidence_excerpts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/excerpt"
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supplement_cap_estimated_tokens",
        "supplement_cap_utf8_bytes",
        "estimated_supplement_tokens",
        "actual_supplement_tokens",
        "counter",
        "host_window_verified"
      ],
      "properties": {
        "supplement_cap_estimated_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "supplement_cap_utf8_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "estimated_supplement_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "actual_supplement_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "counter": {
          "type": "string",
          "minLength": 1
        },
        "host_window_verified": {
          "type": "boolean"
        }
      }
    },
    "degraded_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "capture_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "pending_conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subject_key",
          "candidate_source_ids",
          "suppressed_memory_ids",
          "reason"
        ],
        "properties": {
          "subject_key": {
            "type": "string"
          },
          "candidate_source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "suppressed_memory_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "information_needs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "status",
          "source_event_ids"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "satisfied",
              "unknown",
              "not_applicable"
            ]
          },
          "source_event_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "excerpt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "text",
        "authority",
        "scope",
        "status"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "memory_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "enum": [
            "user_stated",
            "observed",
            "inferred",
            "external"
          ]
        },
        "scope": {
          "enum": [
            "user",
            "project",
            "session",
            "task",
            "turn"
          ]
        },
        "status": {
          "enum": [
            "candidate",
            "active",
            "stale",
            "contradicted",
            "superseded"
          ]
        },
        "source_revision": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "subject_key": {
          "type": "string",
          "minLength": 1
        },
        "effective_revision": {
          "type": "integer",
          "minimum": 0
        },
        "source_event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "origin_kind": {
          "enum": [
            "user_input",
            "assistant_output",
            "tool_result",
            "imported_source",
            "generated_context"
          ]
        },
        "root_source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "depends_on_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
